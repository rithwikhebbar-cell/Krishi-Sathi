NODE_ENV=development
PORT=5000
# Keep all secrets exclusively on the server. Never prefix these with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase Persistence Configuration (M1.3 Phase 4+)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Server-side service role key (NEVER expose to frontend clients or git)
SUPABASE_SERVICE_ROLE_KEY=eyJh...
# Optional client anon key
SUPABASE_ANON_KEY=eyJh...

# Open-Meteo Weather Configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# Approved Agricultural Source Whitelist (SSRF protection)
APPROVED_AGRICULTURAL_DOMAINS=icar.org.in,fao.org,mausam.imd.gov.in,agricoop.nic.in,vikaspedia.in,pau.edu,tnausms.tn.gov.in
RESEARCH_MAX_DOCUMENT_BYTES=2097152

# Bounded Runtime Limits
RESEARCH_MAX_STEPS=4
RESEARCH_MAX_EVIDENCE_ITEMS=20
RESEARCH_TOOL_TIMEOUT_MS=10000
RESEARCH_TOTAL_TIMEOUT_MS=60000
