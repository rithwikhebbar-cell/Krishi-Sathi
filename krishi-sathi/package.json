{
  "name": "krishi-sathi-agentic-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded, evidence-grounded agricultural research agent starter",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "build": "tsc -p tsconfig.json",
